#3. 使用SHAP分析各算法的特征重要性

def analyze_algorithm_shap(algo_name, algo_info, feature_columns, n_top=1000):
    """
    分析单个算法的SHAP特征重要性
    """
    print(f"\n{'='*50}")
    print(f"分析算法: {algo_name}")
    print(f"{'='*50}")
    
    # 获取数据和异常分数
    df = algo_info['data']
    X = df[feature_columns].values
    
    # 由于是异常检测，我们需要训练一个代理模型来学习异常分数
    # 这里使用随机森林作为代理模型
    from sklearn.ensemble import RandomForestRegressor
    
    # 使用前n_top个异常分数最高的样本进行分析
    # 因为异常检测关注的是高分异常样本
    df_sorted = df.sort_values('anomaly_score', ascending=False)
    top_anomalies = df_sorted.head(n_top)
    
    X_top = top_anomalies[feature_columns].values
    y_top = top_anomalies['anomaly_score'].values
    
    # 训练代理模型
    proxy_model = RandomForestRegressor(n_estimators=100, random_state=42, n_jobs=-1)
    proxy_model.fit(X_top, y_top)
    
    # 创建SHAP解释器
    explainer = shap.TreeExplainer(proxy_model)
    
    # 计算SHAP值
    shap_values = explainer.shap_values(X_top)
    
    # 绘制SHAP summary plot
    plt.figure(figsize=(10, 6))
    shap.summary_plot(shap_values, X_top, feature_names=feature_columns, show=False)
    plt.title(f'SHAP Feature Importance - {algo_name}')
    plt.tight_layout()
    plt.savefig(f'shap_summary_{algo_name}.png', dpi=300, bbox_inches='tight')
    plt.show()
    
    # 计算平均绝对SHAP值
    mean_shap = np.abs(shap_values).mean(axis=0)
    feature_importance = pd.DataFrame({
        'feature': feature_columns,
        'mean_shap': mean_shap,
        'algorithm': algo_name
    }).sort_values('mean_shap', ascending=False)
    
    print(f"\n{algo_name} 特征重要性:")
    print(feature_importance)
    
    # 创建特征依赖图
    for i, feature in enumerate(feature_columns):
        plt.figure(figsize=(8, 5))
        shap.dependence_plot(i, shap_values, X_top, 
                            feature_names=feature_columns, show=False)
        plt.title(f'{algo_name} - {feature} Dependence Plot')
        plt.tight_layout()
        plt.savefig(f'shap_dependence_{algo_name}_{feature}.png', dpi=300, bbox_inches='tight')
        plt.show()
    
    return {
        'shap_values': shap_values,
        'feature_importance': feature_importance,
        'proxy_model': proxy_model
    }

# 分析所有算法
results = {}
for algo_name, algo_info in algorithms_data.items():
