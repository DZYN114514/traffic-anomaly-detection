def analyze_feature_interaction(algorithms_data, feature_columns):
    """
    分析特征交互作用
    """
    for algo_name, algo_info in algorithms_data.items():
        df = algo_info['data']
        
        # 创建特征交互图
        fig, axes = plt.subplots(len(feature_columns), len(feature_columns), 
                                 figsize=(15, 15))
        
        for i, feat1 in enumerate(feature_columns):
            for j, feat2 in enumerate(feature_columns):
                ax = axes[i, j]
                
                if i == j:
                    # 对角线：显示特征分布和异常分数
                    scatter = ax.scatter(df[feat1], df['anomaly_score'], 
                                       c=df['anomaly_score'], cmap='viridis', 
                                       alpha=0.5, s=10)
                    ax.set_xlabel(feat1)
                    ax.set_ylabel('Anomaly Score')
                else:
                    # 非对角线：显示特征关系
                    scatter = ax.scatter(df[feat1], df[feat2], 
                                       c=df['anomaly_score'], cmap='viridis', 
                                       alpha=0.5, s=10)
                    ax.set_xlabel(feat1)
                    ax.set_ylabel(feat2)
                
                ax.set_title(f'{algo_name}')
        
        plt.suptitle(f'{algo_name} - Feature Interactions and Anomaly Scores', fontsize=14)
        plt.tight_layout()
        plt.savefig(f'feature_interactions_{algo_name}.png', dpi=300, bbox_inches='tight')
        plt.show()

# 执行分析
analyze_feature_interaction(algorithms_data, feature_columns)
