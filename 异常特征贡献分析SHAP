def analyze_anomaly_definition(algorithms_data, feature_columns, n_anomalies=500):
    """
    分析各算法识别的异常样本的特征分布
    """
    anomaly_profiles = {}
    
    for algo_name, algo_info in algorithms_data.items():
        df = algo_info['data']
        
        # 获取前n_anomalies个异常分数最高的样本
        top_anomalies = df.sort_values('anomaly_score', ascending=False).head(n_anomalies)
        
        # 计算特征统计
        feature_stats = []
        for feature in feature_columns:
            # 获取所有样本的特征分布
            all_values = df[feature].values
            anomaly_values = top_anomalies[feature].values
            
            # 计算异常样本的特征百分位数
            percentile = np.percentile(all_values, np.linspace(0, 100, 101))
            anomaly_percentiles = [np.searchsorted(percentile, val) / 100 
                                  for val in anomaly_values]
            
            feature_stats.append({
                'feature': feature,
                'mean_anomaly': np.mean(anomaly_values),
                'std_anomaly': np.std(anomaly_values),
                'mean_all': np.mean(all_values),
                'std_all': np.std(all_values),
                'mean_percentile': np.mean(anomaly_percentiles),
                'direction': 'high' if np.mean(anomaly_values) > np.mean(all_values) else 'low'
            })
        
        anomaly_profiles[algo_name] = pd.DataFrame(feature_stats)
        
        # 可视化异常样本的特征分布
        fig, axes = plt.subplots(2, 2, figsize=(12, 10))
        axes = axes.flatten()
        
        for idx, feature in enumerate(feature_columns):
            ax = axes[idx]
            
            # 绘制所有样本的分布
            ax.hist(df[feature], bins=50, alpha=0.5, label='All Samples', color='blue')
            
            # 绘制异常样本的分布
            ax.hist(top_anomalies[feature], bins=30, alpha=0.5, 
                   label='Top Anomalies', color='red')
            
            ax.set_xlabel(feature)
            ax.set_ylabel('Frequency')
            ax.set_title(f'{algo_name} - {feature}')
            ax.legend()
        
        plt.suptitle(f'{algo_name} - Anomaly Feature Distribution', fontsize=14)
        plt.tight_layout()
        plt.savefig(f'anomaly_distribution_{algo_name}.png', dpi=300, bbox_inches='tight')
        plt.show()
        
        # 打印特征分析结果
        print(f"\n{algo_name} 异常特征分析:")
        print(anomaly_profiles[algo_name].to_string())
    
    return anomaly_profiles

# 执行分析
anomaly_profiles = analyze_anomaly_definition(algorithms_data, feature_columns)


def create_comparison_summary(results, anomaly_profiles):
    """
    创建算法对比总结
    """
    summary = []
    
    for algo_name in results.keys():
        # 获取特征重要性排序
        importance = results[algo_name]['feature_importance']
        top_features = importance['feature'].iloc[:2].tolist()
        
        # 获取异常特征方向
        profile = anomaly_profiles[algo_name]
        
        feature_directions = {}
        for _, row in profile.iterrows():
            feature_directions[row['feature']] = row['direction']
        
        summary.append({
            'Algorithm': algo_name,
            'Top Features': ', '.join(top_features),
            'Top Feature Importance': f"{importance.iloc[0]['mean_shap']:.3f}",
            'Anomaly Direction': ', '.join([f"{k}:{v}" for k, v in feature_directions.items()]),
            'Interpretation': get_algorithm_interpretation(algo_name, top_features, feature_directions)
        })
    
    summary_df = pd.DataFrame(summary)
    
    # 保存总结
    summary_df.to_csv('algorithm_comparison_summary.csv', index=False)
    
    print("\n" + "="*80)
    print("算法对比总结:")
    print("="*80)
    print(summary_df.to_string())
    
    return summary_df

