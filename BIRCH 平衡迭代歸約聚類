import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.cluster import Birch
from sklearn.preprocessing import StandardScaler
from sklearn.impute import SimpleImputer
from sklearn.decomposition import PCA
import warnings
warnings.filterwarnings('ignore')
# 显示所有列
pd.set_option('display.max_columns', None)



# 列宽不限制
pd.set_option('display.max_colwidth', None)

# 在可视化代码之前添加
plt.rcParams['font.sans-serif'] = ['SimHei']  # 使用黑体
plt.rcParams['axes.unicode_minus'] = False    # 解决负号显示问题

# 1. 读取数据
file_path = r"C:\Users\46686\Desktop\merged_anomaly_data.txt"
df = pd.read_csv(file_path, header=None)
df.columns=['id','time', 'distance', 'speed', 'is_weekend', 'anomaly_score']

print("数据基本信息：")
print(f"数据形状: {df.shape}")
print(f"\n前5行数据:")
print(df.head())


# 2. 选择所有可用特征
features = ['time', 'distance', 'speed', 'is_weekend']

print(f"\n用于聚类的特征: {features}")
print(f"特征说明：")
print(f"  - time: 行驶时间")
print(f"  - distance: 行驶距离")
print(f"  - speed: 速度")



# 3. 数据预处理
print(f"\n缺失值情况:")
print(df[features].isnull().sum())

# 处理缺失值
imputer = SimpleImputer(strategy='median')
X = imputer.fit_transform(df[features])

# 标准化（is_weekend 是0/1二值特征，标准化后仍保持相对关系）
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)



optimal_k=4  




# BIRCH - 专门为大数据设计
birch = Birch(n_clusters=4,           # 最终聚类数
              threshold=0.5,          # 子簇半径阈值
              branching_factor=50)    # 分支因子

df['cluster'] = birch.fit_predict(X_scaled)

# 6. 各聚类特征统计
print(f"\n聚类结果统计：")
print(df['cluster'].value_counts().sort_index())
df.to_csv(r'C:\Users\46686\Desktop\brichdata.txt', index=False,header=False)
# 详细统计
cluster_stats = df.groupby('cluster')[features].agg(['mean', 'std'])
print(f"\n各聚类特征统计：")
print(cluster_stats.round(3))



# 8. 可视化
# PCA降维
pca = PCA(n_components=2)
X_pca = pca.fit_transform(X_scaled)

# 直接绘图，不需要 subplot
plt.figure(figsize=(5, 4))  # 可以调整图形大小
scatter = plt.scatter(X_pca[:, 0], X_pca[:, 1], c=df['cluster'], cmap='viridis', alpha=0.6, s=1)
plt.colorbar(scatter, label='聚类标签')
plt.xlabel('第一主成分')
plt.ylabel('第二主成分')
plt.title('Birch聚类结果（含周末特征）')
plt.grid(True)

plt.tight_layout()
plt.show()

# 9. 聚类特征对比（分工作日和周末）
print("\n" + "="*50)
print("聚类特征对比（按工作日/周末细分）：")
print("="*50)

for cluster_id in range(optimal_k):
    cluster_data = df[df['cluster'] == cluster_id]
    weekday_data = cluster_data[cluster_data['is_weekend'] == 0]
    weekend_data = cluster_data[cluster_data['is_weekend'] == 1]
    
    print(f"\n聚类 {cluster_id}:")
    if len(weekday_data) > 0:
        print(f"  工作日 (n={len(weekday_data)}): 速度={weekday_data['speed'].mean():.1f}, 时间={weekday_data['time'].mean():.1f}")
    if len(weekend_data) > 0:
        print(f"  周末   (n={len(weekend_data)}): 速度={weekend_data['speed'].mean():.1f}, 时间={weekend_data['time'].mean():.1f}")

# 10. 聚类解释
print("\n" + "="*60)
print("聚类分析总结（含周末特征）：")
print("="*60)


for i in range(optimal_k):
    cluster_data = df[df['cluster'] == i]
    weekend_pct = cluster_data['is_weekend'].mean()
    
    print(f"\n【聚类 {i}】样本数: {len(cluster_data)} ({len(cluster_data)/len(df):.1%})")
    print(f"  ├─ 周末占比: {weekend_pct:.1%}")
    print(f"  ├─ 平均时间: {cluster_data['time'].mean():.2f}")
    print(f"  ├─ 平均距离: {cluster_data['distance'].mean():.2f}")
    print(f"  ├─ 平均速度: {cluster_data['speed'].mean():.2f}")
    print(f"  └─ 平均异常分: {cluster_data['anomaly_score'].mean():.2f}")
    
    # 智能标签
    speed = cluster_data['speed'].mean()
    anomaly = cluster_data['anomaly_score'].mean()
    time_mean = cluster_data['time'].mean()
    
    if weekend_pct > 0.6:
        if speed < df['speed'].mean():
            print(f"  🏷️ 标签: 周末休闲低速型")
        else:
            print(f"  🏷️ 标签: 周末出行型")
    elif weekend_pct < 0.3:
        if time_mean > df['time'].mean():
            print(f"  🏷️ 标签: 工作日长时通勤型")
        elif speed > df['speed'].mean():
            print(f"  🏷️ 标签: 工作日快速出行型")
        else:
            print(f"  🏷️ 标签: 工作日常规出行型")
    else:
        if anomaly > df['anomaly_score'].mean():
            print(f"  🏷️ 标签: 混合时段异常型")
        else:
            print(f"  🏷️ 标签: 混合时段普通型")
