import pandas as pd
import numpy as np
from scipy.stats import mstats, kendalltau
from scipy.stats import chi2  # 导入chi2分布

def calculate_kendalls_w(data_dict):
    """
    计算肯德尔和谐系数
    """
    # 获取所有方法的异常分数（第6列，索引5）
    scores = []
    method_names = []
    
    for name, df in data_dict.items():
        score = df.iloc[:, 5].values  # 假设异常分数在第6列
        scores.append(score)
        method_names.append(name)
    
    m = len(method_names)  # 评价者数量
    n = len(scores[0])     # 样本数量
    
    print(f"\n评价方法数: {m}")
    print(f"样本数量: {n}")
    
    # 创建排名矩阵
    ranks = np.zeros((m, n))
    
    # 计算每个方法的排名
    for i, score in enumerate(scores):
        ranks[i, :] = mstats.rankdata(score)
        print(f"{method_names[i]} 异常分数范围: [{score.min():.4f}, {score.max():.4f}]")
    
    # 计算每个样本的总排名
    sum_ranks = np.sum(ranks, axis=0)
    
    # 计算肯德尔和谐系数
    sum_R_squared = np.sum(sum_ranks ** 2)
    
    W = (12 * sum_R_squared - 3 * m**2 * n * (n + 1)**2) / (m**2 * n * (n**2 - 1))
    
    # 计算卡方统计量 - 注意不要命名为chi2，避免与函数冲突
    chi2_stat = m * (n - 1) * W
    # 自由度
    df = n - 1
    # p值 - 使用导入的chi2函数
    p_value = 1 - chi2.cdf(chi2_stat, df)
    
    return W, chi2_stat, p_value, df, ranks, sum_ranks

