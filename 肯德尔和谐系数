# 两两相关性分析
def pairwise_kendall_tau(data_dict):
    """
    计算所有方法对之间的肯德尔秩相关系数
    """
    method_names = list(data_dict.keys())
    n_methods = len(method_names)
    
    tau_matrix = pd.DataFrame(np.zeros((n_methods, n_methods)), 
                              index=method_names, 
                              columns=method_names)
    p_matrix = pd.DataFrame(np.zeros((n_methods, n_methods)), 
                            index=method_names, 
                            columns=method_names)
    
    for i, name1 in enumerate(method_names):
        for j, name2 in enumerate(method_names):
            if i <= j:
                score1 = data_dict[name1]['anomaly_score'].values
                score2 = data_dict[name2]['anomaly_score'].values
                tau, p_val = kendalltau(score1, score2)
                tau_matrix.iloc[i, j] = tau
                tau_matrix.iloc[j, i] = tau
                p_matrix.iloc[i, j] = p_val
                p_matrix.iloc[j, i] = p_val
    
    return tau_matrix, p_matrix

