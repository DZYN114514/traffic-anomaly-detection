# 1. 读取数据
file_path = r"C:\Users\46686\Desktop\merged_anomaly_data.txt"
df = pd.read_csv(file_path, header=None)
df.columns=['id','time', 'distance', 'speed', 'is_weekend', 'anomaly_score']

print("数据基本信息：")
print(f"数据形状: {df.shape}")
print(f"\n前5行数据:")
print(df.head())


# 2. 选择所有可用特征
features = ['time', 'distance', 'speed', 'is_weekend']

print(f"\n用于聚类的特征: {features}")
print(f"特征说明：")
print(f"  - time: 行驶时间")
print(f"  - distance: 行驶距离")
print(f"  - speed: 速度")



# 3. 数据预处理
print(f"\n缺失值情况:")
print(df[features].isnull().sum())

# 处理缺失值
imputer = SimpleImputer(strategy='median')
X = imputer.fit_transform(df[features])

# 标准化（is_weekend 是0/1二值特征，标准化后仍保持相对关系）
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# 4. 确定最优K值
inertias = []
K_range = range(1, 11)
for k in K_range:
    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)
    kmeans.fit(X_scaled)
    inertias.append(kmeans.inertia_)

# 自动寻找肘部点的方法
def find_optimal_k(X_scaled, max_k=10):
    """自动寻找最优K值"""
    inertias = []
    K_range = range(1, max_k + 1)
    
    for k in K_range:
        kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)
        kmeans.fit(X_scaled)
        inertias.append(kmeans.inertia_)
    
    # 计算每个点的曲率（二阶导数）
    # 曲率最大的点就是肘部点
    first_deriv = np.diff(inertias)  # 一阶导
    second_deriv = np.diff(first_deriv)  # 二阶导
    elbow_idx = np.argmax(second_deriv) + 2  # +2 因为diff会减少2个元素
    optimal_k = K_range[elbow_idx]
    
    return optimal_k, inertias

# 使用自动检测
optimal_k, inertias = find_optimal_k(X_scaled)
print(f"自动检测的最优K值: {optimal_k}")


# 绘制肘部图
plt.figure(figsize=(15, 5))

plt.subplot(1, 3, 1)
plt.plot(K_range, inertias, 'bo-')
plt.xlabel('K值')
plt.ylabel('惯性')
plt.title('肘部法则确定最优K值')
plt.grid(True)

# 5. 执行K-Means聚类（K=3或4）

print(f"\n选择K={optimal_k}")

kmeans = KMeans(n_clusters=optimal_k, random_state=42, n_init=10)
df['cluster'] = kmeans.fit_predict(X_scaled)
df.to_csv(r'C:\Users\46686\Desktop\kmeansdata.txt', index=False,header=False)
