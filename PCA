import numpy as np
import pandas as pd
from pyod.models.pca import PCA
from sklearn.preprocessing import StandardScaler
import matplotlib.pyplot as plt
import time

start_time = time.time()

data = pd.read_csv("C:\\Users\\46686\\Desktop\\new.txt", header=None, names=[ 'taxi_id','trip_time', 'distance','velocity','ifweekend'])
data2 = data[['trip_time', 'distance', 'velocity', 'ifweekend']]
clf = PCA(n_components=2, contamination=0.05)
clf.fit(data2)
y_pred = clf.predict(data2)
y_scores = clf.decision_function(data2)

data['is_anomaly'] = y_pred
data['anomaly_score'] = y_scores

normal = data[data['is_anomaly'] == 0]
anomalies = data[data['is_anomaly'] == 1]

#时间
end_time = time.time()
elapsed_time = end_time - start_time
print(f"process time: {elapsed_time:.4f} seconds")

# 按照异常分数降序排列
# 在原数据上直接排序
data.sort_values('anomaly_score', ascending=False, inplace=True)

# 保存为CSV文件
anomaly_data = data[data['is_anomaly'] == 1]
anomaly_data=anomaly_data[['taxi_id','trip_time','distance','velocity','ifweekend','anomaly_score']]
anomaly_data.to_csv('C:\\Users\\46686\\Desktop\\PCA anomaly_data.txt', index=False,header=False, encoding='utf-8')

#求统计量
# 提取已排序的anomaly_score列
scores = anomaly_data['anomaly_score'].values  # 转为numpy数组更快

# 利用已排序特性计算统计量
n = len(scores)

# 1. 平均值（无法利用排序优化）
mean_val = np.mean(scores)

# 2. 方差（无法利用排序优化）
var_val = np.var(scores)

# 3. 中位数（可以利用排序！）
if n % 2 == 1:
    median_val = scores[n // 2]  # 奇数个，中间那个
else:
    median_val = (scores[n // 2 - 1] + scores[n // 2]) / 2  # 偶数个，中间两个平均

# 4. 极差（可以利用排序！）
range_val = scores[0] - scores[-1]  # 最大值 - 最小值（因为是降序）

# 5. 众数（无法利用排序太多，但可以用numpy加速）
# 方法A：使用numpy（更快）
values, counts = np.unique(scores, return_counts=True)
mode_val = values[np.argmax(counts)]

# 方法B：如果数据量大，可以用这个（更快但需安装）
# from scipy import stats
# mode_val = stats.mode(scores, keepdims=True)[0][0]

print(f"ping jun zhi: {mean_val:.4f}")
print(f"fang cha: {var_val:.4f}")
print(f"zhong wei shu: {median_val:.4f}")
print(f"ji cha: {range_val:.4f}")
print(f"zhong shu: {mode_val:.4f}")



print(f'Taxi Trip Anomaly Detection (PyOD PCA), contamination={clf.contamination}')
print(f"there are {len(anomalies)} anomaly points")
print("\nanomaly points (sorted by anomaly score descending):")
# 选择 is_anomaly 为 1 的所有行
anomaly_data = data[data['is_anomaly'] == 1]
print(anomaly_data)
print("\nnormal points (sorted by anomaly score descending):")
# 选择 is_anomaly 为 0 的所有行
anomaly_data = data[data['is_anomaly'] == 0]
print(anomaly_data)



# 创建散点图矩阵
columns = ['trip_time', 'distance', 'velocity', 'ifweekend']


# 方法B：使用seaborn（效果更好，可区分异常点）
import seaborn as sns


normal_data = data[data['is_anomaly'] == 0].sample(frac=0.001, random_state=42)  # 10%采样
anomaly_data = data[data['is_anomaly'] == 1] .sample(frac=0.01, random_state=42)
sampled_data = pd.concat([normal_data, anomaly_data])

# 绘制pairplot，用颜色区分异常点
sns.pairplot(sampled_data, vars=columns,
             hue='is_anomaly',  # 按异常标签着色
             palette={0: 'blue', 1: 'red'},
             plot_kws={'alpha': 0.6, 's': 1},
             diag_kind='hist',
              diag_kws={
                 'bins': 30,           # 控制柱子数量
                 'alpha': 0.7,         # 透明度
                 'edgecolor': 'black', # 柱子边框
                 'linewidth': 0.5,     # 边框粗细
                 'kde': False,         # 不叠加KDE曲线
                 'element': 'bars',    # 纯柱子
                 'fill': True,         # 填充柱子
                 'common_norm': False  # 分别标准化
             },
             height=1.8 )  # 对角线用直方图估计
plt.gcf().canvas.manager.set_window_title('PCA anomaly detection')
plt.suptitle('PCA', y=1.02)
plt.show()





# 1. 优化后的直方图（使用更少的bins避免过密）
fig, axes = plt.subplots(1, 3, figsize=(16, 5))

# 直方图优化
# 使用 'stepfilled' 减少内存，bins=200 对于19万数据足够
n_bins = min(200, int(np.sqrt(len(scores))))  # 自适应bins数
hist_counts, bin_edges, patches = axes[0].hist(scores, bins=n_bins, 
                                                edgecolor='black', 
                                                alpha=0.7,
                                                linewidth=0.5)  # 减小线宽
axes[0].set_yscale('log')
axes[0].set_xlabel('Anomaly Score', fontsize=11)
axes[0].set_ylabel('Frequency (log scale)', fontsize=11)
axes[0].set_title(f'Score Distribution (n={len(scores):,})', fontsize=12)
axes[0].axvline(mean_val, color='red', linestyle='--', linewidth=1.5, label=f'Mean ({mean_val})')
axes[0].axvline(median_val, color='green', linestyle='--', linewidth=1.5, label=f'Median ({median_val})')
axes[0].legend(fontsize=9)
axes[0].grid(alpha=0.3, linestyle=':', linewidth=0.5)

# 2. 箱线图优化（大样本时使用更简洁的表示）
# 对于大样本，boxplot会很慢，使用百分位数替代
percentiles = np.percentile(scores, [0, 1, 5, 25, 50, 75, 95, 99, 100])
stats_text = f'Min: {percentiles[0]:.4f}\n' \
             f'P1: {percentiles[1]:.4f}\n' \
             f'P5: {percentiles[2]:.4f}\n' \
             f'Q1: {percentiles[3]:.4f}\n' \
             f'Median: {percentiles[4]:.4f}\n' \
             f'Q3: {percentiles[5]:.4f}\n' \
             f'P95: {percentiles[6]:.4f}\n' \
             f'P99: {percentiles[7]:.4f}\n' \
             f'Max: {percentiles[8]:.4f}'

# 使用简化版箱线图（只显示关键统计量）
bp = axes[1].boxplot(scores, vert=True, patch_artist=True,
                      showfliers=False,  # 不显示离群点（太多会卡死）
                      widths=0.6,
                      boxprops=dict(facecolor='lightblue', alpha=0.7))
axes[1].set_ylabel('Anomaly Score (log scale)', fontsize=11)
axes[1].set_title('Boxplot Summary (Outliers hidden)', fontsize=12)
axes[1].set_yscale('log')
axes[1].text(1.1, np.percentile(scores, 50), stats_text, 
             fontsize=8, verticalalignment='center',
             bbox=dict(boxstyle='round', facecolor='wheat', alpha=0.5))
axes[1].grid(alpha=0.3, axis='y', linestyle=':', linewidth=0.5)

# 3. 累积分布优化（使用抽样加速）
# 对于19万数据，排序没问题，但绘图时可以抽样
sample_size = min(50000, len(scores))  # 最多用5万个点绘图
if len(scores) > sample_size:
    indices = np.linspace(0, len(scores)-1, sample_size, dtype=int)
    scores_sorted = np.sort(scores)[indices]
else:
    scores_sorted = np.sort(scores)

cumulative = np.linspace(0, 1, len(scores_sorted))
axes[2].plot(scores_sorted, cumulative, 'b-', linewidth=1.5, alpha=0.8)
axes[2].set_xlabel('Anomaly Score', fontsize=11)
axes[2].set_ylabel('CDF', fontsize=11)
axes[2].set_title('Cumulative Distribution Function', fontsize=12)
axes[2].axvline(mean_val, color='red', linestyle='--', linewidth=1.5, label=f'Mean ({mean_val})')
axes[2].axvline(median_val, color='green', linestyle='--', linewidth=1.5, label=f'Median ({median_val})')
axes[2].axhline(0.95, color='purple', linestyle=':', linewidth=1, label='95th percentile')
axes[2].axhline(0.99, color='orange', linestyle=':', linewidth=1, label='99th percentile')
axes[2].legend(fontsize=9)
axes[2].set_xscale('log')
axes[2].grid(alpha=0.3, linestyle=':', linewidth=0.5)

plt.tight_layout()
plt.show()
