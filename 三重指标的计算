import pandas as pd
from sklearn.metrics import silhouette_score, calinski_harabasz_score, davies_bouldin_score
file_path = r"C:\Users\46686\Desktop\kmeansdata.txt"
df = pd.read_csv(file_path, header=None, names=[ 'taxi_id','trip_time','distance','velocity','ifweekend','cluster'])
feature_cols = ['trip_time','distance','velocity','ifweekend']

df = df.sample(frac=0.1, random_state=42)#按照10%采样
print("caiyangchenggong")
X = df[feature_cols].values
labels = df['cluster'].values

# 1. 轮廓系数 (Silhouette Coefficient) — 越接近1越好
sil = silhouette_score(X, labels)
print(f"轮廓系数 (Silhouette): {sil:.4f}")

# 2. 方差比 (Calinski-Harabasz Index) — 越大越好
ch = calinski_harabasz_score(X, labels)
print(f"方差比 (C-H Index): {ch:.4f}")

# 3. DB指数 (Davies-Bouldin Index) — 越小越好
db = davies_bouldin_score(X, labels)
print(f"DB指数 (Davies-Bouldin): {db:.4f}")


