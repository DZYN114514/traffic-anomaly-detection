        common_samples_info.append(sample_info)
    
    common_df = pd.DataFrame(common_samples_info)
    common_df.to_csv(f'C:/Users/46686/Desktop/common_top{K}_samples.csv', index=False)
    print(f"已导出{len(common_ids_all)}个共同样本到 common_top{K}_samples.csv")
