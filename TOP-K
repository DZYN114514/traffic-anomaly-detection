top_k_ids_all = [set(datasets[name].head(K)['id'].values) for name in algorithms]
common_ids_all = set.intersection(*top_k_ids_all)

if common_ids_all:
    # 找出这些样本在各个算法中的异常分数
    common_samples_info = []
    for sample_id in common_ids_all:
