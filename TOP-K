# -*- coding: utf-8 -*-
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from itertools import combinations
import warnings
warnings.filterwarnings('ignore')

plt.rcParams['font.sans-serif'] = ['SimHei']        # 指定默认字体为黑体
plt.rcParams['axes.unicode_minus'] = False          # 解决负号 '-' 显示为方块的问题

# 读取数据
KNN_data = pd.read_csv("C:/Users/46686/Desktop/KNN anomaly_data.txt", header=None)
isolation_forest_data = pd.read_csv("C:/Users/46686/Desktop/isolation forest anomaly_data.txt", header=None)
COPOD_data = pd.read_csv("C:/Users/46686/Desktop/COPOD anomaly_data.txt", header=None)
HBOS_data = pd.read_csv("C:/Users/46686/Desktop/HBOS anomaly_data.txt", header=None)
PCA_data = pd.read_csv("C:/Users/46686/Desktop/PCA anomaly_data.txt", header=None)

# 为数据添加列名
columns = ['id', 'time', 'distance', 'speed', 'is_weekend', 'anomaly_score']
datasets = {
    'KNN': KNN_data,
    'IForest': isolation_forest_data,
    'COPOD': COPOD_data,
    'HBOS': HBOS_data,
    'PCA': PCA_data
}

# 为每个数据集添加列名
for name, df in datasets.items():
    df.columns = columns
    # 确保按异常分数降序排序（如果文件已经是降序，这步可以省略）
    df.sort_values('anomaly_score', ascending=False, inplace=True)
    df.reset_index(drop=True, inplace=True)

# 定义要分析的K值
K_values = [1000, 10000, 100000, 173793] 
algorithms = list(datasets.keys())

# 存储重叠率结果
overlap_results = {k: {} for k in K_values}

# 对每个K值进行分析
for K in K_values:
    print(f"\n{'='*50}")
    print(f"分析 Top-{K} 异常样本重叠情况")
    print(f"{'='*50}")
    
    # 获取每个算法的前K个样本的id集合
    top_k_ids = {}
    for name, df in datasets.items():
        top_k_ids[name] = set(df.head(K)['id'].values)
    
    # 计算每个算法单独的重叠情况（与所有其他算法的交集）
    print(f"\n1. 各算法与所有其他算法同时重叠的样本数：")
    for name in algorithms:
        # 与其他所有算法的交集
        other_sets = [top_k_ids[other] for other in algorithms if other != name]
        if other_sets:
            common_ids = top_k_ids[name].intersection(*other_sets)
            overlap_count = len(common_ids)
            overlap_rate = overlap_count / K * 100
            print(f"   {name}: {overlap_count}/{K} ({overlap_rate:.2f}%)")
            overlap_results[K][f"{name}_with_all"] = overlap_rate
    
    # 计算两两算法之间的重叠率
    print(f"\n2. 两两算法之间的重叠率（%）：")
    overlap_matrix = pd.DataFrame(index=algorithms, columns=algorithms, dtype=float)
    
    for algo1, algo2 in combinations(algorithms, 2):
        intersection = len(top_k_ids[algo1].intersection(top_k_ids[algo2]))
        overlap_rate_1 = intersection / K * 100
        overlap_rate_2 = intersection / K * 100
        overlap_matrix.loc[algo1, algo2] = overlap_rate_1
        overlap_matrix.loc[algo2, algo1] = overlap_rate_2
        print(f"   {algo1} & {algo2}: {intersection}/{K} ({overlap_rate_1:.2f}%)")
    
    # 设置对角线为100
    for algo in algorithms:
        overlap_matrix.loc[algo, algo] = 100.0
    
    # 保存重叠矩阵
    overlap_results[K]['pairwise_matrix'] = overlap_matrix
    
    # 计算所有算法的共同交集（5个算法都重叠的样本）
    all_common = set.intersection(*[top_k_ids[name] for name in algorithms])
    all_common_count = len(all_common)
    all_common_rate = all_common_count / K * 100
    print(f"\n3. 所有5个算法共同重叠的样本数：{all_common_count}/{K} ({all_common_rate:.2f}%)")
    overlap_results[K]['all_common'] = all_common_rate
    
    # 统计每个异常样本被多少个算法检测到
    print(f"\n4. Top-{K}样本被多个算法检测到的分布：")
    id_vote_count = {}
    for name in algorithms:
        for idx in top_k_ids[name]:
            id_vote_count[idx] = id_vote_count.get(idx, 0) + 1
    
    # 统计投票分布
    vote_distribution = {}
    for vote in range(1, len(algorithms) + 1):
        count = sum(1 for v in id_vote_count.values() if v == vote)
        vote_distribution[vote] = count
    
    for vote in sorted(vote_distribution.keys()):
        count = vote_distribution[vote]
        percentage = count / K * 100
        print(f"   被{vote}个算法检测到: {count}个样本 ({percentage:.2f}%)")
    
    overlap_results[K]['vote_distribution'] = vote_distribution

# 可视化结果
fig, axes = plt.subplots(2, 2, figsize=(15, 12))

# 1. 不同K值下的所有算法共同重叠率对比
ax1 = axes[0, 0]
k_values_plot = list(overlap_results.keys())
all_common_rates = [overlap_results[k]['all_common'] for k in k_values_plot]
ax1.plot(k_values_plot, all_common_rates, marker='o', linewidth=2, markersize=8)
ax1.set_xlabel('K', fontsize=12)
ax1.set_ylabel('所有算法的共同重叠率(%)', fontsize=12)
ax1.set_title('不同K值下五个算法的重叠率', fontsize=14)
ax1.grid(True, alpha=0.3)
for i, (k, rate) in enumerate(zip(k_values_plot, all_common_rates)):
    ax1.annotate(f'{rate:.1f}%', (k, rate), textcoords="offset points", xytext=(0,10), ha='center')

# 2. 各算法与所有其他算法的平均重叠率（不同K值）
ax2 = axes[0, 1]
for algo in algorithms:
    rates = [overlap_results[k][f"{algo}_with_all"] for k in k_values_plot]
    ax2.plot(k_values_plot, rates, marker='o', label=algo, linewidth=2)
ax2.set_xlabel('K', fontsize=12)
ax2.set_ylabel('所有算法的共同重叠率 (%)', fontsize=12)
ax2.set_title('不同K值下五个算法的重叠率', fontsize=14)
ax2.legend()
ax2.grid(True, alpha=0.3)



# 4. 投票分布对比（不同K值）
ax4 = axes[1, 1]
x = np.arange(1, 6)
width = 0.25
colors = ['#1f77b4', '#ff7f0e', '#2ca02c']

for i, k in enumerate(k_values_plot):
    vote_dist = overlap_results[k]['vote_distribution']
    counts = [vote_dist.get(vote, 0) / k * 100 for vote in range(1, 6)]
    bars = ax4.bar(x + i*width, counts, width, label=f'K={k}')
    
ax4.set_xlabel('检测到的算法数量', fontsize=12)
ax4.set_ylabel(' (%)', fontsize=12)
ax4.set_title('不同K 值下异常样本投票分布', fontsize=14)
ax4.set_xticks(x + width)
ax4.set_xticklabels(['one algorithm', 'two algorithm', '3 algorithm', '4 algorithm', '5 algorithm'])
ax4.legend()
ax4.grid(True, alpha=0.3, axis='y')

plt.tight_layout()
plt.savefig('C:/Users/46686/Desktop/overlap_analysis.png', dpi=300, bbox_inches='tight')
plt.show()

# 输出详细报告到文件
with open('C:/Users/46686/Desktop/overlap_analysis_report.txt', 'w', encoding='utf-8') as f:
    f.write("="*60 + "\n")
    f.write("Top-K 异常检测重叠率分析报告\n")
    f.write("="*60 + "\n\n")
    
    for K in K_values:
        f.write(f"\n{'='*50}\n")
        f.write(f"Top-{K} 异常样本分析\n")
        f.write(f"{'='*50}\n\n")
        
        f.write("1. 各算法与所有其他算法的共同重叠率：\n")
        for algo in algorithms:
            rate = overlap_results[K][f"{algo}_with_all"]
            f.write(f"   {algo}: {rate:.2f}%\n")
        
        f.write(f"\n2. 所有5个算法的共同重叠率：{overlap_results[K]['all_common']:.2f}%\n")
        
        f.write("\n3. 投票分布：\n")
        vote_dist = overlap_results[K]['vote_distribution']
        for vote in sorted(vote_dist.keys()):
            percentage = vote_dist[vote] / K * 100
            f.write(f"   被{vote}个算法检测到: {vote_dist[vote]}个样本 ({percentage:.2f}%)\n")
        
        f.write("\n4. 两两算法重叠率矩阵：\n")
        pairwise_matrix = overlap_results[K]['pairwise_matrix']
        f.write(pairwise_matrix.round(2).to_string())
        f.write("\n\n")

print("\n分析完成！结果已保存到桌面：")
print("- 可视化图表: overlap_analysis.png")
print("- 详细报告: overlap_analysis_report.txt")

